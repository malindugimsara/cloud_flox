    border-right: 1px solid #E2E8F0;
    box-shadow: 0 4px 10px -2px rgba(15, 23, 42, 0.06);
}

.cf-comparison-table thead th:last-child {
    border-right: none;
}

/* Top-Left Corner Header (Sticky both vertically and horizontally) */
.cf-sticky-feature-th {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 30 !important;
    background: #FFFFFF !important;
    text-align: left !important;
