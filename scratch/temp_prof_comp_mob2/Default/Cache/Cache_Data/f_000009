    border-bottom: 2px solid #CBD5E1 !important;
    box-shadow: 4px 4px 10px rgba(15, 23, 42, 0.06);
}

.cf-feature-heading span {
    display: block;
    font-size: 16px;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.02em;
}

.cf-feature-heading small {
    display: block;
    font-size: 12px;
    color: #64748B;
    font-weight: 500;
    margin-top: 3px;
}

.cf-plan-header-cell {
    position: relative;
    padding: 22px 16px !important;
    min-width: 175px;
}

/* Most Popular Column Highlight */
.cf-plan-header-cell.popular-col {
    background: #FFFBF7 !important;
}

/* Most Popular Column Highlight */
.cf-plan-header-cell.popular-col,
.cf-comparison-table tbody td.popular-col {
    background: rgba(249, 115, 22, 0.025) !important;

}



.cf-popular-tag {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #FF6B00 0%, #EA580C 100%);
    color: #FFFFFF;
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
