    flex-shrink: 0;
    transition: all 0.25s ease;
}

.domain-mega-search-box:focus-within .domain-search-icon,
.domain-mega-search-box:hover .domain-search-icon {
    background: #2563EB;
    color: #FFFFFF !important;
}

.domain-mega-search-box input {
    flex: 1;
    min-width: 0;
    border: 0 !important;
    outline: 0 !important;
    background: transparent !important;
    color: #0F172A !important;
    font-size: 16.5px;
    font-weight: 500;
    padding: 12px 10px;
    box-shadow: none !important;
}

.domain-mega-search-box input::placeholder {
