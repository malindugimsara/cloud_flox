    padding: 84px 0 100px !important;
    position: relative;
    overflow: hidden;
}

.cta-banner-card {
    position: relative;
    opacity: 1 !important;
    visibility: visible !important;
    background: linear-gradient(145deg, #070E1F 0%, #0C1A38 45%, #050B17 100%) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-top: 1px solid rgba(96, 165, 250, 0.45) !important;
    border-radius: 28px !important;
    padding: clamp(48px, 6vw, 76px) clamp(24px, 5vw, 64px) !important;
    box-shadow: 0 30px 70px -15px rgba(2, 6, 23, 0.45), 0 0 90px -20px rgba(0, 132, 255, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.15) !important;
    overflow: hidden;
    isolation: isolate;
}

/* Background Cyber Grid Pattern */
.cta-banner-card .cta-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
        radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.08) 1px, transparent 0),
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 32px 32px, 64px 64px, 64px 64px;
    opacity: 0.9;
    pointer-events: none;
    z-index: 0;
}

/* Aurora Glow Orbs */
.cta-banner-card .cta-glow-mesh {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
}

.cta-banner-card .cta-glow-top-right {
    top: -120px;
    right: -80px;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(0, 132, 255, 0.3) 0%, rgba(37, 99, 235, 0.12) 60%, transparent 80%);
}

.cta-banner-card .cta-glow-bottom-left {
    bottom: -100px;
    left: -60px;
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.24) 0%, rgba(234, 88, 12, 0.08) 60%, transparent 80%);
}

/* Inner content */
.cta-inner-content {
    position: relative;
    z-index: 2;
    max-width: 960px;
    margin: 0 auto;
}

/* Status Pill */
.cta-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(96, 165, 250, 0.3);
    backdrop-filter: blur(8px);
    padding: 6px 18px;
    border-radius: 999px;
    margin-bottom: 22px;
}

.cta-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 10px #10B981;
    animation: ctaPulseDot 2s infinite ease-in-out;
}

@keyframes ctaPulseDot {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.4;
        transform: scale(1.3);
    }
}

.cta-status-text {
    font-size: 13px;
    font-weight: 600;
    color: #93C5FD;
    letter-spacing: 0.02em;
}

/* Title */
.cta-banner-title {
    color: #FFFFFF !important;
    font-size: clamp(30px, 3.8vw, 44px) !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    letter-spacing: -0.02em !important;
    margin-bottom: 18px !important;
}

.cta-gradient-text {
    background: linear-gradient(135deg, #60A5FA 0%, #38BDF8 50%, #FB923C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
}

/* Description */
.cta-banner-desc {
    color: #94A3B8 !important;
    font-size: clamp(15px, 1.2vw, 17px) !important;
    line-height: 1.65 !important;
    max-width: 660px !important;
    margin: 0 auto 32px !important;
}

/* Button Wrapper */
.cta-buttons-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 38px;
}

/* Primary Button Glow */
.btn-cta-primary-glow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 34px;
    border-radius: 12px;
    background: linear-gradient(135deg, #FF6B00 0%, #EA580C 100%) !important;
    color: #FFFFFF !important;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 28px -4px rgba(234, 88, 12, 0.5), 0 0 15px rgba(255, 107, 0, 0.3) !important;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
}

.btn-cta-primary-glow::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
    transform: skewX(-20deg);
    transition: 0.6s ease;
}

.btn-cta-primary-glow:hover {
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 34px -4px rgba(234, 88, 12, 0.65), 0 0 25px rgba(255, 107, 0, 0.45) !important;
}

.btn-cta-primary-glow:hover::after {
    left: 140%;
}

.btn-cta-primary-glow i {
    font-size: 16px;
    transition: transform 0.2s ease;
}

.btn-cta-primary-glow:hover i {
    transform: translateX(4px);
}

/* Secondary Button Glass */
.btn-cta-glass {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 30px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    backdrop-filter: blur(12px);
    color: #FFFFFF !important;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
}

.btn-cta-glass i {
    font-size: 18px;
    color: #38BDF8;
}

.btn-cta-glass:hover {
    background: rgba(255, 255, 255, 0.12) !important;
    border-color: rgba(255, 255, 255, 0.35) !important;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
}

/* Trust Telemetry Bar */
.cta-trust-bar {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 18px;
    padding: 10px 22px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
}

.cta-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    font-weight: 500;
    color: #CBD5E1;
    white-space: nowrap;
}

.cta-trust-item i {
    font-size: 15px;
    color: #10B981;
}

.cta-trust-divider {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
}

/* Floating Badges for Desktop */
.cta-float-badge {
    position: absolute;
    z-index: 1;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    border-radius: 14px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    transition: transform 0.3s ease;
}

.cta-float-left {
    top: 48px;
    left: 48px;
    animation: ctaFloatGentle 6s ease-in-out infinite alternate;
}

.cta-float-right {
    top: 48px;
    right: 48px;
    animation: ctaFloatGentle 6s ease-in-out infinite 3s alternate;
}

@keyframes ctaFloatGentle {
    0% {
        transform: translateY(0px);
    }
    100% {
        transform: translateY(-8px);
    }
}

.cta-float-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(0, 132, 255, 0.15);
    color: #38BDF8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
}

.cta-float-icon.icon-green {
    background: rgba(16, 185, 129, 0.15);
    color: #10B981;
}

.cta-float-info {
    text-align: left;
    display: flex;
    flex-direction: column;
}

.cta-float-info strong {
    font-size: 12.5px;
    color: #F8FAFC;
    font-weight: 700;
}

.cta-float-info span {
    font-size: 11px;
    color: #94A3B8;
}

/* Responsive adjustments */
@media (max-width: 991px) {
    .modern-cta-section {
        padding: 60px 0 80px !important;
    }
    .cta-banner-card {
        padding: 44px 20px !important;
        border-radius: 20px !important;
    }
    .cta-trust-bar {
        border-radius: 16px;
        padding: 14px 18px;
        flex-direction: column;
        gap: 12px;
    }
    .cta-trust-divider {
        display: none !important;
    }
}

@media (max-width: 575px) {
    .cta-buttons-wrapper {
        flex-direction: column;
        width: 100%;
    }
    .btn-cta-primary-glow,
    .btn-cta-glass {
        width: 100%;
    }
}

