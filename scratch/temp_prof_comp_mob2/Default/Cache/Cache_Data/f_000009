/* =========================================
   3. MODERN LIVE NETWORK & GLOBAL METRICS (COMPACT VIDEO HUD)
========================================= */

.modern-stats-section {
    position: relative;
    padding: 34px 20px 36px !important;
    overflow: hidden;
    color: #FFFFFF;
    background: #0B1120;
    border-top: 1px solid rgba(56, 189, 248, 0.18);
    border-bottom: 1px solid rgba(56, 189, 248, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 12px 30px rgba(0, 0, 0, 0.35);
}

/* Background Video Styling */
.stats-bg-video {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
    z-index: 0;
    pointer-events: none;
    opacity: 0.65;
    filter: brightness(0.95) contrast(1.15) saturate(1.2);
}

/* Gradient Overlay for Readability */
.stats-video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(11, 17, 32, 0.86) 0%, rgba(15, 23, 42, 0.76) 50%, rgba(2, 6, 23, 0.88) 100%);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 1;
}

/* Content Wrapper to stay above video */
.stats-content-wrapper {
    position: relative;
    z-index: 2;
}

/* Compact High-Tech Glassmorphism Stat Cards */
.modern-stat-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(15, 23, 42, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
    height: 100%;
}

.modern-stat-card:hover {
    transform: translateY(-3px);
    background: rgba(26, 38, 64, 0.75);
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 8px 24px rgba(56, 189, 248, 0.16);
}

/* Stat Icon Pill */
.stat-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    transition: all 0.25s ease;
}

.modern-stat-card:hover .stat-icon-wrap {
    transform: scale(1.08);
}

.icon-green {
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #34D399;
}

.icon-blue {
    background: rgba(37, 99, 235, 0.18);
    border: 1px solid rgba(59, 130, 246, 0.35);
    color: #60A5FA;
}

.icon-cyan {
    background: rgba(6, 182, 212, 0.16);
    border: 1px solid rgba(6, 182, 212, 0.35);
    color: #22D3EE;
}

.icon-orange {
    background: rgba(249, 115, 22, 0.16);
    border: 1px solid rgba(249, 115, 22, 0.35);
    color: #FB923C;
}

/* Stat Details */
.stat-details {
    flex: 1;
    min-width: 0;
}

/* Stat Number with Vibrant Gradient */
.modern-stat-card .stat-number {
    font-size: clamp(22px, 2.1vw, 28px) !important;
    font-weight: 800 !important;
    line-height: 1.1 !important;
    margin-bottom: 2px !important;
    letter-spacing: -0.02em !important;
    color: #FFFFFF !important;
    background: linear-gradient(180deg, #FFFFFF 25%, #38BDF8 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    font-variant-numeric: tabular-nums !important;
}

/* Stat Label */
.modern-stat-card .stat-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #E2E8F0;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Stat Meta / Sub-Badge */
.modern-stat-card .stat-meta {
    font-size: 11px;
    font-weight: 600;
    color: #94A3B8;
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 3px;
    white-space: nowrap;
}

/* Pulsing Live Dot */
.live-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
    animation: livePulseGlow 2s infinite ease-in-out;
}

.pulse-green {
    background: #10B981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);
}

.pulse-blue {
    background: #38BDF8;
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.8);
}

.pulse-cyan {
    background: #22D3EE;
    box-shadow: 0 0 6px rgba(34, 211, 238, 0.8);
}

.pulse-orange {
    background: #FB923C;
    box-shadow: 0 0 6px rgba(251, 146, 60, 0.8);
}

@keyframes livePulseGlow {

    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.45;
        transform: scale(0.85);
    }
}

/* Responsive Adjustments for Mobile & Tablets */
@media (max-width: 991.98px) {
    .modern-stat-card {
        padding: 12px 14px;
        gap: 12px;
    }

