/* =========================================================
   CloudFlox Redesign — load AFTER include/css.inc.php
   Minimal, premium, white-first. Overrides only; no markup changes.
   ========================================================= */
:root {
    --cf-bg: #FFFFFF;
    --cf-bg-alt: #F7F8FA;
    --cf-ink: #111827;
    --cf-muted: #64748B;
    --cf-orange: #F97316;
    --cf-orange-dark: #EA580C;
    --cf-blue: #2563EB;
    --cf-border: #E5E7EB;
    --cf-white: #FFFFFF;
    --cf-radius: 8px;
    --cf-radius-sm: 6px;
    --cf-shadow: 0 1px 2px rgba(17, 24, 39, .04), 0 4px 16px rgba(17, 24, 39, .04);
    --cf-font: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

html {
    overflow-x: clip !important;
    max-width: 100vw !important;
}

body {
    overflow-x: clip !important;
    max-width: 100vw !important;
    position: relative !important;
    width: 100% !important;
}

body.pure-white-theme {
    background: var(--cf-bg) !important;
    color: var(--cf-ink);
    font-family: var(--cf-font) !important;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
}

body.pure-white-theme h1,
body.pure-white-theme h2,
body.pure-white-theme h3,
body.pure-white-theme h4,
body.pure-white-theme h5 {
    font-family: var(--cf-font) !important;
    color: var(--cf-ink);
    letter-spacing: -0.02em;
}

body.pure-white-theme .container {
    max-width: 1200px;
}

body.pure-white-theme a {
    transition: color .15s ease;
}

body.pure-white-theme :focus-visible {
    outline: 2px solid var(--cf-blue);
    outline-offset: 2px;
}

section[class^="modern-"],
section[class*=" modern-"] {
    padding: 88px 0;
    background: var(--cf-bg);
}

.modern-tech-section,
.modern-reviews-section {
    background: var(--cf-bg-alt) !important;
}

section[class^="modern-"]::before,
section[class^="modern-"]::after {
    display: none !important;
}

.section-tag,
.hero-pill-badge,
.showcase-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--cf-white) !important;
    color: var(--cf-ink) !important;
    border: 1px solid var(--cf-border) !important;
    box-shadow: none !important;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
}

.section-tag i,
.showcase-badge i {
    color: var(--cf-orange);
}

.pulse-dot {
    background: var(--cf-orange) !important;
}

.section-title {
    font-size: clamp(28px, 3.4vw, 40px) !important;
    font-weight: 800 !important;
    line-height: 1.15 !important;
    color: var(--cf-ink) !important;
    margin: 16px 0 12px;
}

.section-subtitle,
.hero-desc,
.showcase-desc,
.cta-banner-desc {
    color: var(--cf-muted) !important;
    font-size: 17px;
    line-height: 1.7;
}

.text-gradient-primary,
.brand-highlight,
.speed-highlight {
    background: none !important;
    -webkit-text-fill-color: currentColor !important;
    color: var(--cf-orange) !important;
}

/* ---------- Header (shared include) ---------- */
header,
.header,
.main-header,
.navbar {
    background: var(--cf-white) !important;
    border-bottom: 1px solid var(--cf-border) !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
}

header .nav-link,
.navbar .nav-link,
header nav a {
    color: var(--cf-ink) !important;
    font-weight: 500;
}

header .nav-link:hover,
.navbar .nav-link:hover,
header nav a:hover {
    color: var(--cf-orange) !important;
}

header .dropdown-menu,
.navbar .dropdown-menu {
    border: 1px solid var(--cf-border) !important;
    border-radius: var(--cf-radius) !important;
    box-shadow: var(--cf-shadow) !important;
}

/* ---------- Buttons ---------- */
.btn-minimal-primary,
.btn-cta-primary,
.plan-cta-btn.btn-solid-orange,
#domainSearchBtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--cf-radius-sm) !important;
    background: var(--cf-orange) !important;
    color: var(--cf-white) !important;
    border: 1px solid var(--cf-orange) !important;
    box-shadow: none !important;
    font-weight: 600;
    font-size: 15px;
    transition: background .15s ease, transform .15s ease;
}

.btn-minimal-primary:hover,
.btn-cta-primary:hover,
.plan-cta-btn.btn-solid-orange:hover,
#domainSearchBtn:hover {
    background: var(--cf-orange-dark) !important;
    border-color: var(--cf-orange-dark) !important;
    transform: translateY(-1px);
}

.btn-minimal-secondary,
.plan-cta-btn.btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--cf-radius-sm) !important;
    background: var(--cf-white) !important;
    color: var(--cf-ink) !important;
    border: 1px solid var(--cf-border) !important;
    box-shadow: none !important;
    font-weight: 600;
    font-size: 15px;
}

.btn-minimal-secondary:hover,
.plan-cta-btn.btn-outline:hover {
    border-color: var(--cf-ink) !important;
}

/* ---------- Hero ---------- */
.modern-hero-section {
    position: relative;
    padding: 70px 40px 65px !important;
    background: #FFFFFF !important;
    overflow: hidden;
}

/* Ambient light decorative aura */
.hero-ambient-glow {
    position: absolute;
    top: -100px;
    right: -80px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, rgba(249, 115, 22, 0.05) 45%, transparent 70%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
}

.hero-content-wrap {
    position: relative;
    z-index: 2;
}

/* Live pill badge */
.hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px 6px 10px;
    background: #F8FAFC !important;
    border: 1px solid #E2E8F0 !important;
    border-radius: 999px;
    margin-bottom: 22px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
    transition: all 0.25s ease;
    text-decoration: none;
}

.hero-pill-badge:hover {
    border-color: #CBD5E1 !important;
    background: #FFFFFF !important;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06) !important;
}

.pulse-dot {
    width: 9px;
    height: 9px;
    background: #10B981 !important;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulseGreenGlow 2s infinite;
}

@keyframes pulseGreenGlow {
    0% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }

    70% {
        box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
}

.badge-text {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
}

.badge-arrow {
    font-size: 11px;
    color: #94A3B8;
    transition: transform 0.2s ease, color 0.2s ease;
}

.hero-pill-badge:hover .badge-arrow {
    transform: translateX(2px);
    color: #2563EB;
}

/* Hero Typography */
.hero-title {
    font-size: clamp(34px, 4.1vw, 56px) !important;
    font-weight: 800 !important;
    line-height: 1.15 !important;
    letter-spacing: -0.035em;
    color: #0F172A !important;
    margin: 0 0 18px 0;
}

.hero-text-accent {
    color: #2563EB !important;
    display: inline-block;
}

.hero-desc {
    font-size: 17px !important;
    line-height: 1.65 !important;
    color: #64748B !important;
    margin-bottom: 26px;
    max-width: 580px;
}

/* Hero CTAs */
.hero-cta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
}

.btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--cf-orange) !important;
    color: #FFFFFF !important;
    font-weight: 600;
    font-size: 15px;
    padding: 12.5px 26px;
    border-radius: 8px !important;
    border: 1px solid var(--cf-orange) !important;
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.28) !important;
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-hero-primary:hover {
    background: var(--cf-orange-dark) !important;
    border-color: var(--cf-orange-dark) !important;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(249, 115, 22, 0.38) !important;
}

.btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F8FAFC !important;
    color: #1E293B !important;
    font-weight: 600;
    font-size: 15px;
    padding: 12.5px 22px;
    border-radius: 8px !important;
    border: 1px solid #E2E8F0 !important;
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-hero-secondary:hover {
    background: #FFFFFF !important;
    border-color: #94A3B8 !important;
    color: #0F172A !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
}

/* Unified Single-Line Social Proof & Trust Bar */
.hero-trust-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 14px;
    font-size: 13.5px;
    color: #64748B;
    padding-top: 2px;
}

.trust-rating-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.rating-stars {
    color: #F59E0B;
    font-size: 13.5px;
    display: inline-flex;
    gap: 2px;
}

.rating-label {
    font-size: 13px;
    color: #64748B;
}

.rating-label strong {
    color: #0F172A;
    font-weight: 700;
}

.trust-dot-divider {
    color: #CBD5E1;
    font-size: 12px;
    user-select: none;
}

.trust-perk-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #475569;
    font-size: 13px;
    font-weight: 500;
}

.trust-perk-badge i {
    font-size: 16px;
}

/* =========================================================================
   2. Dedicated Highlighted Domain Search Section
   ========================================================================= */
.modern-domain-section {
    position: relative;
    padding: 30px 20px 60px !important;
    background: #FFFFFF !important;
}

.domain-showcase-box {
    position: relative;
    background-color: #FFFFFF;
    background-image:
        radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.08) 0%, rgba(249, 115, 22, 0.04) 45%, transparent 70%),
        radial-gradient(rgba(37, 99, 235, 0.12) 1.2px, transparent 1.2px);
    background-size: 100% 100%, 28px 28px;
    border: 3px solid #2563EB;
    border-radius: 24px;
    padding: 48px 32px 38px;
    box-shadow: 0 25px 60px -15px rgba(37, 99, 235, 0.12), 0 0 0 1px rgba(37, 99, 235, 0.1);
    overflow: hidden;
}

.domain-showcase-glow {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 280px;
    background: radial-gradient(ellipse at center, rgba(37, 99, 235, 0.1) 0%, rgba(249, 115, 22, 0.05) 50%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
}

/* Concentric Radar Scanning Wave Background */
.domain-radar-waves {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 780px;
    height: 780px;
    pointer-events: none;
    z-index: 1;
}

.radar-wave {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
}

.radar-wave.w-1 {
    width: 320px;
    height: 320px;
    border: 1px dashed rgba(37, 99, 235, 0.13);
    animation: radarPulse 10s linear infinite;
}

.radar-wave.w-2 {
    width: 540px;
    height: 540px;
    border: 1px dashed rgba(37, 99, 235, 0.08);
    animation: radarPulseReverse 16s linear infinite;
}

.radar-wave.w-3 {
    width: 760px;
    height: 760px;
    border: 1px dashed rgba(37, 99, 235, 0.05);
}

@keyframes radarPulse {
    0% {
        transform: translate(-50%, -50%) rotate(0deg);
    }

    100% {
        transform: translate(-50%, -50%) rotate(360deg);
    }
}

@keyframes radarPulseReverse {
    0% {
        transform: translate(-50%, -50%) rotate(360deg);
    }

    100% {
        transform: translate(-50%, -50%) rotate(0deg);
    }
}

/* Floating TLD Watermarks */
.domain-float-badge {
    position: absolute;
    z-index: 2;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 999px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    pointer-events: none;
    user-select: none;
}

.float-tld-ext {
    font-size: 13px;
    font-weight: 800;
    color: #0F172A;
}

.float-tld-tag {
    font-size: 11px;
    font-weight: 700;
    color: #64748B;
}

.float-tld-text {
    font-size: 11.5px;
    font-weight: 600;
    color: #475569;
}

.float-tld-icon {
    font-size: 14px;
}

.deco-left-top {
    top: 32px;
    left: 32px;
    animation: heroFloatSlow 5s ease-in-out infinite alternate;
}

.deco-left-bottom {
    bottom: 34px;
    left: 34px;
    animation: heroFloatAlt 6s ease-in-out infinite alternate;
}

.deco-right-top {
    top: 32px;
    right: 32px;
    animation: heroFloatAlt 5.5s ease-in-out infinite alternate;
}

.deco-right-bottom {
    bottom: 34px;
    right: 34px;
    animation: heroFloatSlow 6.5s ease-in-out infinite alternate;
}

.domain-highlight-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 999px;
    margin-bottom: 18px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
    font-size: 13px;
    font-weight: 600;
    color: #1E293B;
}

.pulse-dot-blue {
    width: 8px;
    height: 8px;
    background: #2563EB;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7);
    animation: pulseBlueGlow 2s infinite;
}

@keyframes pulseBlueGlow {
    0% {
        box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7);
    }

    70% {
        box-shadow: 0 0 0 8px rgba(37, 99, 235, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
    }
}

.domain-pill-save {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
    padding: 2px 8px;
    border-radius: 999px;
}

.domain-section-title {
    font-size: clamp(24px, 3.2vw, 36px) !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    letter-spacing: -0.025em;
    color: #0F172A !important;
    margin: 0 0 12px 0;
}

.domain-section-desc {
    font-size: 16px !important;
    line-height: 1.6 !important;
    color: #64748B !important;
    margin: 0 auto 28px auto;
    max-width: 660px;
}

/* Mega Search Box - Highlighted & Elevated */
.domain-mega-search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    background: #FFFFFF !important;
    border: 2px solid #2563EB !important;
    border-radius: 16px !important;
    padding: 8px 10px 8px 16px !important;
    box-shadow: 0 16px 40px -10px rgba(37, 99, 235, 0.22), 0 0 0 5px rgba(37, 99, 235, 0.08) !important;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    max-width: 780px;
    margin: 0 auto 28px auto;
}

.domain-mega-search-box:hover {
    border-color: #1D4ED8 !important;
    box-shadow: 0 20px 45px -8px rgba(37, 99, 235, 0.28), 0 0 0 6px rgba(37, 99, 235, 0.12) !important;
    transform: translateY(-2px);
}

.domain-mega-search-box:focus-within {
    background: #FFFFFF !important;
    border-color: #1D4ED8 !important;
    box-shadow: 0 22px 50px -8px rgba(37, 99, 235, 0.35), 0 0 0 7px rgba(37, 99, 235, 0.16) !important;
    transform: translateY(-2px);
}

.domain-search-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
