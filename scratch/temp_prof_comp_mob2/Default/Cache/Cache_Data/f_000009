}

.domain-mega-btn:hover {
    background: linear-gradient(135deg, #F97316 0%, #C2410C 100%) !important;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -2px rgba(234, 88, 12, 0.55) !important;
}

/* TLD Showcase Cards */
.domain-tld-showcase {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 28px;
}

.tld-card {
